---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { withBase } from '../../utils/paths';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const noteCategoryLabels: Record<string, string> = {
  'Research Record': '科研记录',
  'Reading Note': '读书笔记',
  'Technical Note': '技术笔记'
};
---

<Layout title="笔记" description="科研记录、读书笔记与技术笔记。">
  <section class="page-hero compact">
    <div class="container">
      <p class="eyebrow" data-lang-zh="笔记" data-lang-en="Notes">笔记</p>
      <h1 data-lang-zh="笔记" data-lang-en="Notes">笔记</h1>
      <p
        data-lang-zh="科研记录、读书笔记和技术笔记都可以用 Markdown / MDX 持续追加。"
        data-lang-en="Research records, reading notes, and technical notes can be maintained with Markdown or MDX."
      >
        科研记录、读书笔记和技术笔记都可以用 Markdown / MDX 持续追加。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container note-list">
      {
        notes.map((note) => (
          <article class="note-item">
            <div class="item-heading">
              <span
                class="tag"
                data-lang-zh={noteCategoryLabels[note.data.category] ?? note.data.category}
                data-lang-en={note.data.category}
              >
                {noteCategoryLabels[note.data.category] ?? note.data.category}
              </span>
              <time
                datetime={note.data.date.toISOString()}
                data-lang-zh={note.data.date.toLocaleDateString('zh-CN')}
                data-lang-en={note.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              >
                {note.data.date.toLocaleDateString('zh-CN')}
              </time>
            </div>
            <h2>
              <a
                href={withBase(`/notes/${note.slug}/`)}
                data-lang-zh={note.data.title}
                data-lang-en={note.data.titleEn ?? note.data.title}
              >
                {note.data.title}
              </a>
            </h2>
            <p data-lang-zh={note.data.summary} data-lang-en={note.data.summaryEn ?? note.data.summary}>{note.data.summary}</p>
            <div class="keyword-list">
              {note.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
