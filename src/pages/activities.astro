---
import Layout from '../components/Layout.astro';
import Timeline from '../components/Timeline.astro';
import { activities } from '../data/activities';
---

<Layout title="学术活动" description="会议汇报、课程汇报、学术讲座、文献讨论与科研训练。">
  <section class="page-hero compact">
    <div class="container">
      <p class="eyebrow" data-lang-zh="学术活动" data-lang-en="Activities">学术活动</p>
      <h1 data-lang-zh="学术活动" data-lang-en="Academic Activities">学术活动</h1>
      <p
        data-lang-zh="这里归档会议汇报、课程汇报、学术讲座、文献讨论和真实发生的科研训练材料。"
        data-lang-en="This page archives conference talks, course presentations, academic lectures, literature discussions, and research training records."
      >
        这里归档会议汇报、课程汇报、学术讲座、文献讨论和真实发生的科研训练材料。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Timeline items={activities} />
    </div>
  </section>
</Layout>
