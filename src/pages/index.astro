---
import Layout from '../components/Layout.astro';
import CurrentWorkCard from '../components/CurrentWorkCard.astro';
import SelectedPublication from '../components/SelectedPublication.astro';
import WorkItem from '../components/WorkItem.astro';
import ResourceItem from '../components/ResourceItem.astro';
import { currentWorks } from '../data/currentWork';
import { profile } from '../data/profile';
import { publications } from '../data/publications';
import { resourceCategories, resourceCategoryLabelsEn, resources, type ResourceCategory } from '../data/resources';
import { homeWritingSlugs, works } from '../data/works';
import { withBase } from '../utils/paths';

const selectedPublication =
  publications.find((publication) => publication.graphicalAbstract?.showOnHome) ??
  publications.find((publication) => publication.status === 'Published');

const homeWriting = homeWritingSlugs
  .map((slug) => works.find((work) => work.slug === slug))
  .filter((work): work is (typeof works)[number] => Boolean(work))
  .slice(0, 4);

const featuredResourceIds = [
  'fluid-mechanics-ta-homework',
  'advanced-atmospheric-dynamics',
  'machine-learning-notes'
];
const featuredResources = featuredResourceIds
  .map((id) => resources.find((resource) => resource.id === id))
  .filter((resource): resource is (typeof resources)[number] => Boolean(resource));

const resourceCategorySlugs: Record<ResourceCategory, string> = {
  数学基础: 'mathematics',
  大气专业课程: 'atmospheric-science',
  助教课程: 'teaching-assistant',
  科研写作: 'scientific-writing',
  机器学习: 'machine-learning',
  LaTeX: 'latex',
  代码: 'code',
  Book: 'books'
};
---

<Layout
  title="研究 · 笔记 · 写作"
  description="秦政的个人科研与文学主页，记录大气科学、卫星遥感、云微物理、降水机器学习反演、研究笔记、课程资料与文学作品。"
>
  <section class="hero" style={`--hero-image: url('${withBase(profile.heroImage)}')`}>
    <div class="hero-overlay">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow" data-lang-zh={profile.siteSubtitle} data-lang-en={profile.siteSubtitleEn}>{profile.siteSubtitle}</p>
          <h1 data-lang-zh={profile.formalNameCn} data-lang-en={profile.formalNameEn}>{profile.formalNameCn}</h1>
          <p
            class="hero-role"
            data-lang-zh={`${profile.currentRole} · ${profile.affiliation}`}
            data-lang-en={`${profile.currentRoleEn}, ${profile.affiliationEn}`}
          >
            {profile.currentRole} · {profile.affiliation}
          </p>
          <p class="hero-field" data-lang-zh="大气科学 · 卫星遥感 · 云微物理" data-lang-en="Atmospheric science · Satellite remote sensing · Cloud microphysics">大气科学 · 卫星遥感 · 云微物理</p>
          <p
            data-lang-zh={profile.bioShort}
            data-lang-en={profile.bioShortEn}
          >
            {profile.bioShort}
          </p>
          <div class="hero-actions">
            <a class="button" href={withBase('/research/')} data-lang-zh="研究" data-lang-en="Research">研究</a>
            <a class="button secondary" href={withBase('/publications/')} data-lang-zh="发表成果" data-lang-en="Publications">发表成果</a>
            <a class="button secondary" href={withBase('/works/')} data-lang-zh="文学作品" data-lang-en="Writing">文学作品</a>
          </div>
        </div>
        <aside class="profile-panel" aria-label="个人概览">
          <img class="profile-photo" src={withBase(profile.avatar)} alt={`${profile.formalNameCn} 个人照片`} width="320" height="420" />
          <div>
            <strong data-lang-zh={profile.nameCn} data-lang-en={profile.nameEn}>{profile.nameCn}</strong>
            <span data-lang-zh={profile.archiveLabel} data-lang-en={profile.archiveLabelEn}>{profile.archiveLabel}</span>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow" data-lang-zh="当前研究" data-lang-en="Current Work">当前研究</p>
        <h2 data-lang-zh="当前研究" data-lang-en="Current Work">当前研究</h2>
      </div>
      <div class="card-grid">
        {currentWorks.map((work) => <CurrentWorkCard work={work} />)}
      </div>
    </div>
  </section>

  <section class="section resource-note-band">
    <div class="container">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow" data-lang-zh="资料与笔记" data-lang-en="Resources & Notes">资料与笔记</p>
          <h2 data-lang-zh="资料＆笔记" data-lang-en="Resources & Notes">资料＆笔记</h2>
          <p
            class="section-summary"
            data-lang-zh="课程资料、助教归档、book、slides 与代码材料集中放在这里，作为长期维护的学习和科研入口。"
            data-lang-en="Course materials, teaching records, books, slides, and code materials are grouped here as a long-term study and research archive."
          >
            课程资料、助教归档、book、slides 与代码材料集中放在这里，作为长期维护的学习和科研入口。
          </p>
        </div>
        <div class="split-actions">
          <a class="text-button" href={withBase('/resources/')} data-lang-zh="进入资料馆" data-lang-en="View resources">进入资料馆</a>
        </div>
      </div>
      <nav class="resource-home-nav" aria-label="资料分类入口">
        {
          resourceCategories.map((category) => (
            <a
              href={withBase(`/resources/#resource-${resourceCategorySlugs[category]}`)}
              data-lang-zh={category}
              data-lang-en={resourceCategoryLabelsEn[category]}
            >
              {category}
            </a>
          ))
        }
      </nav>
      <div class="resource-note-grid resources-only">
        <div class="stack">
          {featuredResources.map((resource) => <ResourceItem resource={resource} compact />)}
        </div>
      </div>
    </div>
  </section>

  {
    selectedPublication && (
      <section class="section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow" data-lang-zh="代表成果" data-lang-en="Selected Publication">代表成果</p>
            <h2 data-lang-zh="代表成果" data-lang-en="Selected Publication">代表成果</h2>
          </div>
          <SelectedPublication publication={selectedPublication} />
        </div>
      </section>
    )
  }

  <section class="section literary-band">
    <div class="container">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow" data-lang-zh="文学档案" data-lang-en="Writing Archive">文学档案</p>
          <h2 data-lang-zh="星云档案馆" data-lang-en="Writing Archive">星云档案馆</h2>
          <p
            class="section-summary"
            data-lang-zh="小说、随笔、片段，以及对想象世界的长期记录。"
            data-lang-en="Fiction, essays, fragments, and records of imagined worlds."
          >
            小说、随笔、片段，以及对想象世界的长期记录。
          </p>
        </div>
        <a class="text-button" href={withBase('/works/')} data-lang-zh="进入作品集" data-lang-en="View all writing">进入作品集</a>
      </div>
      <div class="work-grid">
        {homeWriting.map((work) => <WorkItem work={work} />)}
      </div>
    </div>
  </section>
</Layout>
