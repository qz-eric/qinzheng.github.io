---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import WorkItem from '../../components/WorkItem.astro';
import { featuredWorkSlugs, workCollections, works } from '../../data/works';
import { withBase } from '../../utils/paths';

const entries = await getCollection('works', ({ data }) => !data.draft);
const existingSlugs = new Set<string>(entries.map((entry) => entry.slug));
const visibleWorks = works.filter((work) => existingSlugs.has(work.slug));
const visibleCollections = workCollections
  .map((collection) => ({
    ...collection,
    count: visibleWorks.filter((work) => work.collection === collection.slug).length
  }))
  .filter((collection) => collection.count > 0);
const featuredWorks = featuredWorkSlugs
  .map((slug) => visibleWorks.find((work) => work.slug === slug))
  .filter((work): work is (typeof visibleWorks)[number] => Boolean(work));
---

<Layout title="文学作品" description="小说、短篇、散文、设定集与随笔作品集。">
  <section class="page-hero compact literary-hero">
    <div class="container">
      <p class="eyebrow" data-lang-zh="文学作品" data-lang-en="Writing">文学作品</p>
      <h1 data-lang-zh="文学作品" data-lang-en="Writing">文学作品</h1>
      <p
        data-lang-zh="这里放小说、短篇、散文、设定集和随笔。正文来自 Markdown / MDX 文件，适合长期维护。"
        data-lang-en="This archive contains fiction, short pieces, essays, settings, and reflections. Article bodies are maintained in Markdown or MDX."
      >
        这里放小说、短篇、散文、设定集和随笔。正文来自 Markdown / MDX 文件，适合长期维护。
      </p>
    </div>
  </section>

  <section class="section literary-band">
    <div class="container stack large">
      <section>
        <div class="section-heading">
          <p class="eyebrow" data-lang-zh="作品集" data-lang-en="Collections">作品集</p>
          <h2 data-lang-zh="作品集与栏目" data-lang-en="Collections and Columns">作品集与栏目</h2>
        </div>
        <div class="collection-grid">
          {
            visibleCollections.map((collection) => (
              <a class={`collection-card collection-${collection.tone}`} href={withBase(`/works/collections/${collection.slug}/`)}>
                <span>{collection.coverLabel}</span>
                <h3 data-lang-zh={collection.title} data-lang-en={collection.titleEn}>{collection.title}</h3>
                <p class="item-theme" data-lang-zh={collection.subtitle} data-lang-en={collection.subtitleEn}>{collection.subtitle}</p>
                <p data-lang-zh={collection.description} data-lang-en={collection.descriptionEn}>{collection.description}</p>
                <small data-lang-zh={`${collection.count} 篇文章`} data-lang-en={`${collection.count} articles`}>
                  {collection.count} 篇文章
                </small>
              </a>
            ))
          }
        </div>
      </section>

      <section>
        <div class="section-heading">
          <p class="eyebrow" data-lang-zh="精选" data-lang-en="Featured">精选</p>
          <h2 data-lang-zh="精选文章" data-lang-en="Featured Writing">精选文章</h2>
        </div>
        <div class="work-grid">
          {featuredWorks.map((work) => <WorkItem work={work} />)}
        </div>
      </section>
    </div>
  </section>
</Layout>
