---
import Header from './Header.astro';
import Footer from './Footer.astro';
import { profile } from '../data/profile';
import { stripBase, withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
}

const {
  title,
  description = '秦政的个人科研与文学主页，记录大气科学、卫星遥感、云微物理、降水机器学习反演、科研记录、课程资料与文学作品。',
  image = profile.heroImage,
  bodyClass = ''
} = Astro.props;

const siteName = "Qin's Personal Blog";
const pageTitle = title ? (title === siteName ? siteName : `${title} | ${siteName}`) : siteName;
const canonical = new URL(withBase(stripBase(Astro.url.pathname)), Astro.site ?? Astro.url).toString();
const ogImage = new URL(withBase(image), Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class={bodyClass}>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <div class="atmos-cursor" data-atmos-cursor aria-hidden="true"></div>
  </body>
</html>

<script>
  const cursor = document.querySelector<HTMLElement>('[data-atmos-cursor]');
  const finePointer = window.matchMedia('(pointer: fine)');
  const interactiveSelector = [
    'a',
    'button',
    'input',
    'textarea',
    'select',
    'summary',
    '[role="button"]',
    '.link-card',
    '.publication-item.is-clickable',
    '.selected-publication.is-clickable',
    '[data-resource-nav]'
  ].join(',');

  const setCursorPosition = (event: PointerEvent) => {
    if (!cursor || !finePointer.matches) return;
    cursor.style.setProperty('--cursor-x', `${event.clientX}px`);
    cursor.style.setProperty('--cursor-y', `${event.clientY}px`);
    cursor.classList.add('is-visible');
  };

  const setCursorTarget = (target: EventTarget | null) => {
    if (!cursor || !(target instanceof Element)) return;
    cursor.classList.toggle('is-link', Boolean(target.closest(interactiveSelector)));
  };

  if (cursor) {
    window.addEventListener('pointermove', setCursorPosition, { passive: true });
    document.addEventListener('pointerover', (event) => setCursorTarget(event.target));
    document.addEventListener('pointerdown', () => cursor.classList.add('is-pressed'));
    document.addEventListener('pointerup', () => cursor.classList.remove('is-pressed'));
    document.addEventListener('mouseleave', () => cursor.classList.remove('is-visible'));
  }

  const revealTargets = Array.from(
    document.querySelectorAll<HTMLElement>(
      [
        'main .section-heading',
        'main .hero-copy > *',
        'main .profile-panel',
        'main .card',
        'main .current-work-card',
        'main .publication-item',
        'main .selected-publication',
        'main .work-item',
        'main .collection-card',
        'main .resource-item',
        'main .resource-slide-header',
        'main .note-item',
        'main .note-preview',
        'main .entry-card',
        'main .timeline-card',
        'main .skill-block',
        'main .wechat-panel',
        'main .prose > p',
        'main .prose > h2',
        'main .prose > ul',
        'main .prose > ol',
        'main .prose > figure'
      ].join(',')
    )
  );

  const shouldAnimateReveal =
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (shouldAnimateReveal) {
    const initialViewportBottom = window.innerHeight + 48;
    const revealTarget = (target: HTMLElement) => {
      target.classList.remove('is-pending');
      target.classList.add('is-visible');
    };
    const resetTarget = (target: HTMLElement) => {
      target.classList.remove('is-visible');
      target.classList.add('is-pending');
    };
    const updateRevealStates = () => {
      revealTargets.forEach((target) => {
        const rect = target.getBoundingClientRect();
        const isInRevealZone = rect.top < window.innerHeight * 0.92 && rect.bottom > 0;
        const isFarOutside = rect.bottom < -96 || rect.top > window.innerHeight + 96;

        if (isInRevealZone) {
          revealTarget(target);
        } else if (isFarOutside) {
          resetTarget(target);
        }
      });
    };
    let revealFrame = 0;
    const requestRevealUpdate = () => {
      window.cancelAnimationFrame(revealFrame);
      revealFrame = window.requestAnimationFrame(updateRevealStates);
    };

    revealTargets.forEach((target, index) => {
      target.classList.add('scroll-reveal');
      target.style.setProperty('--reveal-delay', `${Math.min(index % 4, 3) * 24}ms`);
      if (target.getBoundingClientRect().top < initialViewportBottom) {
        target.classList.add('is-visible');
        return;
      }
      target.classList.add('is-pending');
    });

    window.addEventListener('scroll', requestRevealUpdate, { passive: true });
    window.addEventListener('resize', requestRevealUpdate, { passive: true });
    window.setTimeout(updateRevealStates, 120);
  } else {
    revealTargets.forEach((target) => target.classList.add('scroll-reveal', 'is-visible'));
  }
</script>
