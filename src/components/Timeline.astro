---
import { activityTypeLabels, activityTypeLabelsEn, type Activity } from '../data/activities';
import { withBase } from '../utils/paths';

interface Props {
  items: Activity[];
}

const { items } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const hrefFor = (href: string) => (isExternal(href) ? href : withBase(href));
const activityToneClass: Record<Activity['type'], string> = {
  Conference: 'tone-conference',
  CourseReport: 'tone-course',
  Lecture: 'tone-lecture',
  Submission: 'tone-publication',
  LiteratureReview: 'tone-review',
  ResearchTraining: 'tone-training'
};
---

<ol class="timeline">
  {
    items.map((item) => (
      <li class:list={['timeline-item', activityToneClass[item.type]]}>
        <div class="timeline-date">{item.date}</div>
        <article class="timeline-card">
          <div class="item-heading">
            <span
              class="tag activity-tag"
              data-lang-zh={activityTypeLabels[item.type]}
              data-lang-en={activityTypeLabelsEn[item.type]}
            >
              {activityTypeLabels[item.type]}
            </span>
            <span data-lang-zh={item.location} data-lang-en={item.locationEn}>{item.location}</span>
          </div>
          <h3 data-lang-zh={item.title} data-lang-en={item.titleEn}>{item.title}</h3>
          <p class="item-theme" data-lang-zh={item.theme} data-lang-en={item.themeEn}>{item.theme}</p>
          <p data-lang-zh={item.description} data-lang-en={item.descriptionEn}>{item.description}</p>
          {item.links.length > 0 && (
            <div class="inline-links">
              {item.links.map((link) => (
                <a
                  href={hrefFor(link.href)}
                  target={isExternal(link.href) ? '_blank' : undefined}
                  rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
                >
                  <span data-lang-zh={link.label} data-lang-en={link.labelEn ?? link.label}>{link.label}</span>
                </a>
              ))}
            </div>
          )}
        </article>
      </li>
    ))
  }
</ol>
