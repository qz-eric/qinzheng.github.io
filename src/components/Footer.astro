---
import { profile } from '../data/profile';
import { withBase } from '../utils/paths';

const year = new Date().getFullYear();
const isExternal = (href: string) => /^https?:\/\//.test(href);
const hrefFor = (href: string) => (isExternal(href) || href.startsWith('#') ? href : withBase(href));
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <strong data-lang-zh={profile.formalNameCn} data-lang-en={profile.formalNameEn}>{profile.formalNameCn}</strong>
      <p
        data-lang-zh={`${profile.archiveLabel} · ${profile.affiliation} · ${profile.location}`}
        data-lang-en={`${profile.archiveLabelEn} · ${profile.affiliationEn} · ${profile.locationEn}`}
      >
        {profile.archiveLabel} · {profile.affiliation} · {profile.location}
      </p>
    </div>
    <div class="footer-links">
      {
        profile.socialLinks.map((link) => (
          <a
            href={hrefFor(link.href)}
            target={isExternal(link.href) ? '_blank' : undefined}
            rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a href={`mailto:${profile.email}`}>Email</a>
    </div>
    <p class="footer-note">© {year} {profile.nameEn}. Built with Astro.</p>
  </div>
</footer>
